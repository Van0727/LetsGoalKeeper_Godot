; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="LetsGoalKeeper_Godot"
run/main_scene="res://scenes/boot.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

DiagnosticsService="*res://autoload/diagnostics_service.gd"
RunState="*res://autoload/run_state.gd"
SaveService="*res://autoload/save_service.gd"
SettingsService="*res://autoload/settings_service.gd"
BgmService="*res://autoload/bgm_service.gd"
SfxService="*res://autoload/sfx_service.gd"

[display]

window/size/viewport_width=360
window/size/viewport_height=640
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[gui]

theme/custom_font="res://assets/fonts/ui_font.tres"

[internationalization]

; 导出时携带中文分词与断行规则，避免试玩包长文案无法按本地规则折行。
locale/include_text_server_data=true

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
