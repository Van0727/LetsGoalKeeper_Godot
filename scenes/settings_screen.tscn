[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/settings_screen.gd" id="1_settings"]

[sub_resource type="ButtonGroup" id="ButtonGroup_metronome"]
allow_unpress = false

[node name="SettingsScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_settings")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.055, 0.082, 0.12, 1)
mouse_filter = 2

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 24.0
offset_top = 16.0
offset_right = -24.0
offset_bottom = -16.0
grow_horizontal = 2
grow_vertical = 2

[node name="Layout" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 7

[node name="Title" type="Label" parent="Margin/Layout"]
layout_mode = 2
theme_override_colors/font_color = Color(0.98, 0.86, 0.27, 1)
theme_override_font_sizes/font_size = 30
text = "设置"
horizontal_alignment = 1

[node name="MasterLabel" type="Label" parent="Margin/Layout"]
layout_mode = 2
text = "主音量"

[node name="MasterSlider" type="HSlider" parent="Margin/Layout"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 38)
layout_mode = 2
max_value = 100.0
step = 1.0

[node name="MusicLabel" type="Label" parent="Margin/Layout"]
layout_mode = 2
text = "音乐音量"

[node name="MusicSlider" type="HSlider" parent="Margin/Layout"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 38)
layout_mode = 2
max_value = 100.0
step = 1.0

[node name="SfxLabel" type="Label" parent="Margin/Layout"]
layout_mode = 2
text = "音效音量"

[node name="SfxSlider" type="HSlider" parent="Margin/Layout"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 38)
layout_mode = 2
max_value = 100.0
step = 1.0

[node name="LanguageLabel" type="Label" parent="Margin/Layout"]
layout_mode = 2
text = "语言"

[node name="LanguageOption" type="OptionButton" parent="Margin/Layout"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 44)
layout_mode = 2

[node name="WindowLabel" type="Label" parent="Margin/Layout"]
layout_mode = 2
text = "显示模式"

[node name="WindowOption" type="OptionButton" parent="Margin/Layout"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 44)
layout_mode = 2

[node name="MetronomeLabel" type="Label" parent="Margin/Layout"]
layout_mode = 2
text = "节拍器样式"

[node name="MetronomeOptions" type="HBoxContainer" parent="Margin/Layout"]
layout_mode = 2
theme_override_constants/separation = 24
alignment = 1

[node name="CircleMetronomeCheck" type="CheckBox" parent="Margin/Layout/MetronomeOptions"]
unique_name_in_owner = true
custom_minimum_size = Vector2(112, 38)
layout_mode = 2
button_group = SubResource("ButtonGroup_metronome")
text = "圆圈"

[node name="WaveformMetronomeCheck" type="CheckBox" parent="Margin/Layout/MetronomeOptions"]
unique_name_in_owner = true
custom_minimum_size = Vector2(112, 38)
layout_mode = 2
button_pressed = true
button_group = SubResource("ButtonGroup_metronome")
text = "波形"

[node name="StatusLabel" type="Label" parent="Margin/Layout"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 24)
layout_mode = 2
theme_override_colors/font_color = Color(0.55, 0.72, 0.82, 1)
text = "修改后立即生效"
horizontal_alignment = 1

[node name="BackButton" type="Button" parent="Margin/Layout"]
custom_minimum_size = Vector2(0, 50)
layout_mode = 2
text = "返回主菜单"

[connection signal="value_changed" from="Margin/Layout/MasterSlider" to="." method="_on_volume_changed"]
[connection signal="value_changed" from="Margin/Layout/MusicSlider" to="." method="_on_volume_changed"]
[connection signal="value_changed" from="Margin/Layout/SfxSlider" to="." method="_on_volume_changed"]
[connection signal="item_selected" from="Margin/Layout/LanguageOption" to="." method="_on_language_selected"]
[connection signal="item_selected" from="Margin/Layout/WindowOption" to="." method="_on_window_selected"]
[connection signal="pressed" from="Margin/Layout/MetronomeOptions/CircleMetronomeCheck" to="." method="_on_circle_metronome_pressed"]
[connection signal="pressed" from="Margin/Layout/MetronomeOptions/WaveformMetronomeCheck" to="." method="_on_waveform_metronome_pressed"]
[connection signal="pressed" from="Margin/Layout/BackButton" to="." method="_on_back_pressed"]
