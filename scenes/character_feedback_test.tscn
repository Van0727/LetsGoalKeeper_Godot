[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/character_feedback_test.gd" id="1_test"]
[ext_resource type="PackedScene" path="res://scenes/character_display.tscn" id="2_display"]

[sub_resource type="StyleBoxFlat" id="StyleBox_pitch"]
bg_color = Color(0.055, 0.22, 0.13, 1)
border_width_left = 3
border_width_top = 3
border_width_right = 3
border_width_bottom = 3
border_color = Color(0.72, 0.9, 0.76, 0.65)
corner_radius_top_left = 18
corner_radius_top_right = 18
corner_radius_bottom_right = 18
corner_radius_bottom_left = 18

[node name="CharacterFeedbackTest" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_test")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.035, 0.075, 0.065, 1)
mouse_filter = 2

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 10
theme_override_constants/margin_top = 10
theme_override_constants/margin_right = 10
theme_override_constants/margin_bottom = 10

[node name="Layout" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Header" type="HBoxContainer" parent="Margin/Layout"]
layout_mode = 2

[node name="BackButton" type="Button" parent="Margin/Layout/Header"]
custom_minimum_size = Vector2(64, 42)
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "返回"

[node name="Title" type="Label" parent="Margin/Layout/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.98, 0.86, 0.27, 1)
theme_override_font_sizes/font_size = 22
text = "角色反馈测试"
horizontal_alignment = 1

[node name="HeaderSpacer" type="Control" parent="Margin/Layout/Header"]
custom_minimum_size = Vector2(64, 0)
layout_mode = 2

[node name="Pitch" type="PanelContainer" parent="Margin/Layout"]
layout_mode = 2
size_flags_vertical = 3
theme_override_styles/panel = SubResource("StyleBox_pitch")

[node name="PitchMargin" type="MarginContainer" parent="Margin/Layout/Pitch"]
layout_mode = 2
theme_override_constants/margin_left = 8
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 8
theme_override_constants/margin_bottom = 8

[node name="Combatants" type="HBoxContainer" parent="Margin/Layout/Pitch/PitchMargin"]
layout_mode = 2
theme_override_constants/separation = 8
alignment = 1

[node name="PlayerDisplay" parent="Margin/Layout/Pitch/PitchMargin/Combatants" instance=ExtResource("2_display")]
unique_name_in_owner = true
layout_mode = 2

[node name="EnemyDisplay" parent="Margin/Layout/Pitch/PitchMargin/Combatants" instance=ExtResource("2_display")]
unique_name_in_owner = true
layout_mode = 2

[node name="Instructions" type="Label" parent="Margin/Layout"]
layout_mode = 2
theme_override_colors/font_color = Color(0.78, 0.86, 0.82, 1)
custom_minimum_size = Vector2(0, 34)
theme_override_font_sizes/font_size = 15
text = "点击按钮检查受击闪色、治疗数字和护盾数字反馈"
horizontal_alignment = 1
vertical_alignment = 1
autowrap_mode = 2

[node name="Buttons" type="GridContainer" parent="Margin/Layout"]
layout_mode = 2
theme_override_constants/h_separation = 8
theme_override_constants/v_separation = 8
columns = 2

[node name="DamageEnemy" type="Button" parent="Margin/Layout/Buttons"]
custom_minimum_size = Vector2(156, 46)
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "敌人受伤 -6"

[node name="DamagePlayer" type="Button" parent="Margin/Layout/Buttons"]
custom_minimum_size = Vector2(156, 46)
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "玩家受击 -5"

[node name="HealPlayer" type="Button" parent="Margin/Layout/Buttons"]
custom_minimum_size = Vector2(156, 46)
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "玩家治疗 +6"

[node name="ShieldPlayer" type="Button" parent="Margin/Layout/Buttons"]
custom_minimum_size = Vector2(156, 46)
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "玩家护盾 +6"

[node name="Reset" type="Button" parent="Margin/Layout"]
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "重置数值"

[connection signal="pressed" from="Margin/Layout/Header/BackButton" to="." method="_on_back_button_pressed"]
[connection signal="pressed" from="Margin/Layout/Buttons/DamageEnemy" to="." method="_on_damage_enemy_pressed"]
[connection signal="pressed" from="Margin/Layout/Buttons/DamagePlayer" to="." method="_on_damage_player_pressed"]
[connection signal="pressed" from="Margin/Layout/Buttons/HealPlayer" to="." method="_on_heal_player_pressed"]
[connection signal="pressed" from="Margin/Layout/Buttons/ShieldPlayer" to="." method="_on_shield_player_pressed"]
[connection signal="pressed" from="Margin/Layout/Reset" to="." method="_on_reset_pressed"]
