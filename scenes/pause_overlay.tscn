text = "取消"
theme_override_styles/normal = SubResource("Style_pause_button")
theme_override_styles/hover = SubResource("Style_pause_button")
theme_override_styles/pressed = SubResource("Style_pause_button")

[connection signal="pressed" from="PauseButton" to="." method="_on_pause_button_pressed"]
[connection signal="pressed" from="PauseCenter/PausePanel/Margin/Buttons/ResumeButton" to="." method="_on_resume_pressed"]
[connection signal="pressed" from="PauseCenter/PausePanel/Margin/Buttons/SettingsButton" to="." method="_on_settings_pressed"]
[connection signal="pressed" from="PauseCenter/PausePanel/Margin/Buttons/MainMenuButton" to="." method="_on_main_menu_pressed"]
[connection signal="pressed" from="PauseCenter/PausePanel/Margin/Buttons/QuitButton" to="." method="_on_quit_pressed"]
[connection signal="pressed" from="ConfirmCenter/ConfirmPanel/Margin/Layout/ConfirmButton" to="." method="_on_confirm_pressed"]
[connection signal="pressed" from="ConfirmCenter/ConfirmPanel/Margin/Layout/CancelButton" to="." method="cancel_confirmation"]
