layout_mode = 2
text = "确定"
theme_override_styles/normal = SubResource("Style_pause_button")
theme_override_styles/hover = SubResource("Style_pause_button")
theme_override_styles/pressed = SubResource("Style_pause_button")

[node name="CancelButton" type="Button" parent="ConfirmCenter/ConfirmPanel/Margin/Layout"]
