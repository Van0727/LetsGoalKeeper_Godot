[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/deck_logic_test.gd" id="1_test"]

[node name="DeckLogicTest" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_test")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.04, 0.07, 0.11, 1)
mouse_filter = 2

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 10
theme_override_constants/margin_top = 10
theme_override_constants/margin_right = 10
theme_override_constants/margin_bottom = 10

[node name="Layout" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Header" type="HBoxContainer" parent="Margin/Layout"]
layout_mode = 2

[node name="BackButton" type="Button" parent="Margin/Layout/Header"]
custom_minimum_size = Vector2(64, 42)
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "返回"

[node name="Title" type="Label" parent="Margin/Layout/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.98, 0.86, 0.27, 1)
theme_override_font_sizes/font_size = 22
text = "牌堆逻辑测试"
horizontal_alignment = 1
vertical_alignment = 1

[node name="HeaderSpacer" type="Control" parent="Margin/Layout/Header"]
custom_minimum_size = Vector2(64, 0)
layout_mode = 2

[node name="ZoneStatus" type="Label" parent="Margin/Layout"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 30)
layout_mode = 2
theme_override_colors/font_color = Color(0.55, 0.82, 1, 1)
theme_override_font_sizes/font_size = 16
horizontal_alignment = 1

[node name="HandStatus" type="Label" parent="Margin/Layout"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 58)
layout_mode = 2
theme_override_font_sizes/font_size = 16
horizontal_alignment = 1
vertical_alignment = 1
autowrap_mode = 2

[node name="DeckLog" type="TextEdit" parent="Margin/Layout"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
theme_override_font_sizes/font_size = 14
editable = false
wrap_mode = 1

[node name="Actions" type="VBoxContainer" parent="Margin/Layout"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Draw" type="Button" parent="Margin/Layout/Actions"]
custom_minimum_size = Vector2(0, 46)
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "回合开始：抽3张"

[node name="Play" type="Button" parent="Margin/Layout/Actions"]
custom_minimum_size = Vector2(0, 46)
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "打出第1张并补牌"

[node name="EndTurn" type="Button" parent="Margin/Layout/Actions"]
custom_minimum_size = Vector2(0, 46)
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "结束回合：弃掉手牌"

[node name="Reset" type="Button" parent="Margin/Layout/Actions"]
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "固定 seed 重置"

[connection signal="pressed" from="Margin/Layout/Header/BackButton" to="." method="_on_back_pressed"]
[connection signal="pressed" from="Margin/Layout/Actions/Draw" to="." method="_on_draw_pressed"]
[connection signal="pressed" from="Margin/Layout/Actions/Play" to="." method="_on_play_pressed"]
[connection signal="pressed" from="Margin/Layout/Actions/EndTurn" to="." method="_on_end_turn_pressed"]
[connection signal="pressed" from="Margin/Layout/Actions/Reset" to="." method="_on_reset_pressed"]
