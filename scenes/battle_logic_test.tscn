[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/battle_logic_test.gd" id="1_test"]
[ext_resource type="Script" path="res://scripts/battle/battle_controller.gd" id="2_controller"]

[node name="BattleLogicTest" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_test")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.035, 0.055, 0.09, 1)
mouse_filter = 2

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 10
theme_override_constants/margin_top = 10
theme_override_constants/margin_right = 10
theme_override_constants/margin_bottom = 10

[node name="Layout" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Header" type="HBoxContainer" parent="Margin/Layout"]
layout_mode = 2

[node name="BackButton" type="Button" parent="Margin/Layout/Header"]
custom_minimum_size = Vector2(64, 42)
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "返回"

[node name="Title" type="Label" parent="Margin/Layout/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.98, 0.86, 0.27, 1)
theme_override_font_sizes/font_size = 22
text = "战斗逻辑测试"
horizontal_alignment = 1
vertical_alignment = 1

[node name="HeaderSpacer" type="Control" parent="Margin/Layout/Header"]
custom_minimum_size = Vector2(64, 0)
layout_mode = 2

[node name="PhaseLabel" type="Label" parent="Margin/Layout"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 28)
layout_mode = 2
theme_override_colors/font_color = Color(0.65, 0.84, 1, 1)
theme_override_font_sizes/font_size = 16
text = "回合 1 · 玩家行动 · 意图 0"
horizontal_alignment = 1

[node name="PlayerStatus" type="Label" parent="Margin/Layout"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 26)
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "玩家  HP 100/100  护盾 0"

[node name="EnemyStatus" type="Label" parent="Margin/Layout"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 26)
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "企鹅  HP 30/30  护盾 0"

[node name="BattleLog" type="TextEdit" parent="Margin/Layout"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
theme_override_font_sizes/font_size = 14
editable = false
wrap_mode = 1

[node name="ActionButtons" type="GridContainer" parent="Margin/Layout"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/h_separation = 8
theme_override_constants/v_separation = 8
columns = 2

[node name="Attack" type="Button" parent="Margin/Layout/ActionButtons"]
custom_minimum_size = Vector2(156, 46)
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "攻击 6"

[node name="Guard" type="Button" parent="Margin/Layout/ActionButtons"]
custom_minimum_size = Vector2(156, 46)
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "护盾 6"

[node name="Heal" type="Button" parent="Margin/Layout/ActionButtons"]
custom_minimum_size = Vector2(156, 46)
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "治疗 6"

[node name="EndTurn" type="Button" parent="Margin/Layout/ActionButtons"]
custom_minimum_size = Vector2(156, 46)
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "结束回合"

[node name="ResetButton" type="Button" parent="Margin/Layout"]
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "重置战斗"

[node name="BattleController" type="Node" parent="."]
unique_name_in_owner = true
script = ExtResource("2_controller")

[connection signal="pressed" from="Margin/Layout/Header/BackButton" to="." method="_on_back_pressed"]
[connection signal="pressed" from="Margin/Layout/ActionButtons/Attack" to="." method="_on_attack_pressed"]
[connection signal="pressed" from="Margin/Layout/ActionButtons/Guard" to="." method="_on_guard_pressed"]
[connection signal="pressed" from="Margin/Layout/ActionButtons/Heal" to="." method="_on_heal_pressed"]
[connection signal="pressed" from="Margin/Layout/ActionButtons/EndTurn" to="." method="_on_end_turn_pressed"]
[connection signal="pressed" from="Margin/Layout/ResetButton" to="." method="_on_reset_pressed"]
